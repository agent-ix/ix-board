<plist version="1.0"><dict>
<key>Label</key><string>com.agentix.ix-board-cadence-due</string>
<key>ProgramArguments</key><array>
<string>/Users/peter/.local/bin/ix-board</string>
<string>cadence</string>
<string>due</string>
<string>--program</string>
<string>QSL</string>
<string>--team</string>
<string>qsl</string>
<string>--alert</string>
